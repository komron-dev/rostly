# ==============================
# DATABASE CONFIGURATION
# ==============================
DB_URL=jdbc:postgresql://localhost:5433/rostly
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ==============================
# MAIL CONFIGURATION (SMTP)
# ==============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ==============================
# APPLICATION ADMIN (INITIAL USER)
# ==============================
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change_me_securely
APP_ADMIN_NAME=Rostly Admin

# ==============================
# JWT CONFIGURATION
# ==============================
APP_JWT_SECRET=your_super_secret_key_here
APP_JWT_ACCESS_TOKEN_EXPIRY=900                 # 15 minutes
APP_JWT_REFRESH_TOKEN_EXPIRY=604800             # 7 days
APP_JWT_VERIFY_EMAIL_TOKEN_EXPIRY=43200         # 12 hours
APP_JWT_CHANGE_EMAIL_TOKEN_EXPIRY=3600          # 1 hour

# ==============================
# STORAGE PATHS
# ==============================
APP_STORAGE_PHOTOS_DIR=./uploads/photos
APP_STORAGE_ANSWERS_DIR=./uploads/answers
APP_STORAGE_VIOLATIONS_DIR=./uploads/violations

# ==============================
# SESSION / TRUST SCORE
# ==============================
APP_SESSION_DEFAULT_TRUST_SCORE=100